# Generic (technology-independent) synthesis of the ITCH parser top, mapped to 6-input
# LUTs to measure logic depth (LUT levels on the longest register/IO -> register/IO path).
# `make synth` reads syn/out/itch_top_sv2v.v (sv2v output: Yosys's native SV frontend
# does not support package imports in the module header), sets MOLD_HDR / PIPE_STAGES
# with chparam, then runs this script once per PIPE_STAGES value.
synth -top itch_top -flatten
abc -lut 6
opt_clean
tee -o syn/out/stat_lut6.txt stat
tee -o syn/out/ltp_lut6.txt ltp -noff
write_json syn/out/lut6.json
